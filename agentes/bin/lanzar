#!/usr/bin/env python3
"""lanzar — abre, lista o cierra sesiones de agentes en Windows Terminal / PowerShell.

  lanzar <nombre>              # abre una pestaña/ventana con el agente definido en agentes.conf
  lanzar --listar              # muestra los agentes configurados y los registrados como abiertos
  lanzar --cerrar <nombre>     # quita el agente del registro de abiertos
"""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

for _s in (sys.stdout, sys.stderr):
    if hasattr(_s, "reconfigure"):
        _s.reconfigure(encoding="utf-8", errors="replace")

DEFAULT_HOME = Path(__file__).resolve().parent.parent
HOME = Path(os.environ.get("AGENTES_HOME") or DEFAULT_HOME)
CONF = HOME / "agentes.conf"
CONF_EXAMPLE = HOME / "agentes.conf.example"
REG = HOME / "estado" / "abiertos.json"


def leer_conf():
    src = CONF if CONF.exists() else CONF_EXAMPLE
    if not src.exists():
        sys.exit(f"lanzar: falta {CONF}")
    agentes = {}
    for line in src.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) < 3:
            continue
        nombre, directorio, rol_rel = parts[:3]
        opts = {}
        if len(parts) >= 4 and parts[3]:
            for item in parts[3].split(","):
                if "=" in item:
                    k, v = item.split("=", 1)
                    opts[k.strip()] = v.strip()
        raw_dir = os.path.expanduser(directorio)
        dir_path = Path(raw_dir) if Path(raw_dir).is_absolute() else (HOME.parent / raw_dir).resolve()
        agentes[nombre] = {"dir": dir_path, "rol": HOME / rol_rel, "opts": opts}
    return agentes


def leer_reg():
    if REG.exists() and REG.read_text(encoding="utf-8").strip():
        return json.loads(REG.read_text(encoding="utf-8"))
    return {}


def guardar_reg(data):
    REG.parent.mkdir(parents=True, exist_ok=True)
    tmp = REG.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
    tmp.replace(REG)


def construir_prompt(nombre, rol_path):
    partes = []
    if rol_path.exists():
        partes.append(rol_path.read_text(encoding="utf-8"))
    comun = HOME / "roles" / "_comun.md"
    if comun.exists():
        partes.append(comun.read_text(encoding="utf-8"))
    prompt_file = HOME / "estado" / f"prompt_{nombre}.txt"
    prompt_file.parent.mkdir(parents=True, exist_ok=True)
    prompt_file.write_text("\n\n".join(partes), encoding="utf-8")
    return prompt_file


def main():
    ap = argparse.ArgumentParser(prog="lanzar")
    ap.add_argument("nombre", nargs="?")
    ap.add_argument("--listar", action="store_true")
    ap.add_argument("--cerrar", metavar="NOMBRE")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()

    agentes = leer_conf()
    reg = leer_reg()

    if a.listar:
        for n, cfg in agentes.items():
            estado = "ABIERTO" if n in reg else "cerrado"
            print(f"- {n:<12} [{estado}]  dir={cfg['dir']}  opts={cfg['opts']}")
        return

    if a.cerrar:
        reg.pop(a.cerrar, None)
        guardar_reg(reg)
        print(f"lanzar: {a.cerrar} marcado como cerrado")
        return

    if not a.nombre:
        ap.error("indica <nombre>, --listar o --cerrar <nombre>")
    if a.nombre not in agentes:
        sys.exit(f"lanzar: '{a.nombre}' no está en {CONF.name}")

    cfg = agentes[a.nombre]
    workdir = cfg["dir"]
    if not workdir.exists():
        sys.exit(f"lanzar: no existe el directorio {workdir}")

    prompt_file = construir_prompt(a.nombre, cfg["rol"])
    model = cfg["opts"].get("model")
    extra_claude = f" --model {model}" if model else ""
    worktree_flag = " --worktree " + a.nombre if cfg["opts"].get("worktree") == "1" else ""

    if os.name == "nt":
        ps_cmd = (
            f"$env:AGENTE='{a.nombre}'; "
            f"$env:AGENTES_HOME='{HOME}'; "
            f"$env:PATH='{HOME / 'bin'};' + $env:PATH; "
            f"Set-Location '{workdir}'; "
            f"$p = Get-Content -Raw -Encoding UTF8 '{prompt_file}'; "
            f"claude -n '{a.nombre}'{extra_claude}{worktree_flag} $p"
        )
        shell = shutil.which("pwsh") or shutil.which("powershell") or "powershell"
        wt = shutil.which("wt")
        cmd = (
            [wt, "-w", "0", "new-tab", "--title", f"agente-{a.nombre}", shell, "-NoExit", "-Command", ps_cmd]
            if wt
            else [shell, "-NoExit", "-Command", ps_cmd]
        )
        creationflags = getattr(subprocess, "CREATE_NEW_CONSOLE", 0) if not wt else 0
    else:
        sh_cmd = (
            f"export AGENTE='{a.nombre}' AGENTES_HOME='{HOME}' PATH='{HOME / 'bin'}:$PATH'; "
            f"cd '{workdir}' && claude -n '{a.nombre}'{extra_claude}{worktree_flag} \"$(cat '{prompt_file}')\""
        )
        cmd = ["bash", "-lc", sh_cmd]
        creationflags = 0

    reg[a.nombre] = {"dir": str(workdir), "ts": int(time.time())}
    guardar_reg(reg)

    if a.dry_run:
        print(" ".join(cmd))
        return

    subprocess.Popen(cmd, creationflags=creationflags)
    print(f"lanzar: abierto agente '{a.nombre}' en {workdir}")


if __name__ == "__main__":
    main()
