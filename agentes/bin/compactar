#!/usr/bin/env python3
"""compactar — convierte una conversación larga (Claude Code o Antigravity) en un documento corto para retomarla.

  compactar <id|nombre> [--resumir] [--max N]   genera $AGENTES_HOME/contexto/conversaciones/<nombre>.md
  compactar nueva <documento.md>                abre sesión nueva con ese documento si claude CLI está disponible
  compactar aviso                               modo hook: avisa una vez cuando el contexto pasa de COMPACT_UMBRAL

Sin --resumir es 100 % extractivo (gratis, sin LLM): peticiones, últimas respuestas, archivos tocados y comandos.
"""
import argparse
import glob
import json
import os
from pathlib import Path
import subprocess
import sys
import time

for _s in (sys.stdout, sys.stderr):
    if hasattr(_s, "reconfigure"):
        _s.reconfigure(encoding="utf-8", errors="replace")

DEFAULT_HOME = Path(__file__).resolve().parent.parent
HOME = Path(os.environ.get("AGENTES_HOME") or DEFAULT_HOME)
BASE_CLAUDE = Path(os.environ.get("CLAUDE_HOME") or (Path.home() / ".claude")) / "projects"
BASE_AGY = Path(os.environ.get("ANTIGRAVITY_BRAIN") or (Path.home() / ".gemini" / "antigravity" / "brain"))
UMBRAL = int(os.environ.get("COMPACT_UMBRAL", "150000"))


def aprox(txt: str) -> int:
    return len(txt) // 4


def encontrar(ref: str) -> tuple[Path | None, str | None]:
    # Antigravity por conversation_id completo o prefijo
    for p in glob.glob(str(BASE_AGY / "*" / ".system_generated" / "logs" / "transcript.jsonl")):
        cid = Path(p).parent.parent.parent.name
        if cid == ref or cid.startswith(ref):
            return Path(p), "agy"
    # Claude Code por filename
    for f in glob.glob(str(BASE_CLAUDE / "*" / "*.jsonl")):
        if Path(f).stem == ref:
            return Path(f), "claude"
    # Claude Code por custom-title
    mejor = None
    for f in glob.glob(str(BASE_CLAUDE / "*" / "*.jsonl")):
        try:
            with open(f, encoding="utf-8", errors="ignore") as fh:
                for i, l in enumerate(fh):
                    if i > 200:
                        break
                    if '"custom-title"' in l and json.loads(l).get("customTitle") == ref:
                        if not mejor or os.path.getmtime(f) > os.path.getmtime(mejor):
                            mejor = f
                        break
        except (OSError, ValueError):
            pass
    return (Path(mejor), "claude") if mejor else (None, None)


def texto_de(content) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    return ""


def analizar_claude(f: Path):
    pet, resp, archivos, cmds, ctx = [], [], [], [], 0
    nombre = None
    ult_resp = None
    with open(f, encoding="utf-8", errors="ignore") as fh:
        for l in fh:
            try:
                d = json.loads(l)
            except ValueError:
                continue
            t = d.get("type")
            if t == "custom-title":
                nombre = d.get("customTitle") or nombre
            m = d.get("message") or {}
            if t == "user" and not d.get("isMeta"):
                x = texto_de(m.get("content", "")).strip()
                if x and not x.startswith(("<system-reminder", "<command-", "<local-command", "Caveat:")):
                    pet.append(x)
            elif t == "assistant":
                u = m.get("usage") or {}
                if u:
                    ctx = u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0) + u.get("cache_creation_input_tokens", 0)
                for b in m.get("content", []) if isinstance(m.get("content"), list) else []:
                    if b.get("type") == "text" and b.get("text", "").strip():
                        ult_resp = b["text"].strip()
                    elif b.get("type") == "tool_use":
                        i = b.get("input", {})
                        if b.get("name") in ("Edit", "Write", "MultiEdit", "NotebookEdit") and i.get("file_path"):
                            archivos.append(i["file_path"])
                        elif b.get("name") == "Bash" and i.get("command"):
                            cmds.append(i["command"].splitlines()[0][:120])
            if t == "user" and ult_resp:
                resp.append(ult_resp)
                ult_resp = None
    if ult_resp:
        resp.append(ult_resp)
    return nombre or f.stem, pet, resp, archivos, cmds, ctx


def analizar_agy(f: Path):
    cid = f.parent.parent.parent.name
    pet, resp, archivos, cmds, ctx = [], [], [], [], 0
    with open(f, encoding="utf-8", errors="ignore") as fh:
        for l in fh:
            try:
                d = json.loads(l)
            except ValueError:
                continue
            t = d.get("type")
            if t == "USER_INPUT" and d.get("source") == "USER_EXPLICIT":
                txt = str(d.get("content") or "").strip()
                if txt:
                    pet.append(txt)
            elif t == "PLANNER_RESPONSE":
                u_ctx = (d.get("input_tokens") or 0) + (d.get("cache_read_tokens") or 0)
                if u_ctx:
                    ctx = u_ctx
                txt = str(d.get("content") or "").strip()
                if txt:
                    resp.append(txt)
                for tc in d.get("tool_calls") or []:
                    name = tc.get("name", "")
                    args = tc.get("arguments") or tc.get("args") or {}
                    if isinstance(args, str):
                        try:
                            args = json.loads(args)
                        except ValueError:
                            args = {}
                    if name in ("write_file", "edit_file") and args.get("Path"):
                        archivos.append(str(args["Path"]).strip('"'))
                    elif name == "run_command" and args.get("CommandLine"):
                        cmds.append(str(args["CommandLine"]).strip('"').splitlines()[0][:120])
    return f"agy-{cid[:8]}", pet, resp, archivos, cmds, ctx


def cortar(s: str, n: int) -> str:
    s = " ".join(s.split())
    return s if len(s) <= n else s[: n - 1] + "…"


def generar(a):
    f, kind = encontrar(a.ref)
    if not f:
        sys.exit("sesión no encontrada")
    nombre, pet, resp, archivos, cmds, ctx = analizar_agy(f) if kind == "agy" else analizar_claude(f)
    antes = aprox(f.read_text(encoding="utf-8", errors="ignore"))
    n = a.max
    out = [
        f"<!-- fuente: {f} | fecha: {time.strftime('%Y-%m-%d')} | modo: {'extractivo+LLM' if a.resumir else 'extractivo'} -->",
        f"# Conversación compactada: {nombre}",
        "",
        "> Documento para retomar el trabajo en una sesión NUEVA. El registro completo está en la ruta de arriba por si hace falta detalle.",
        "",
        f"## Peticiones del usuario (últimas {min(n, len(pet))} de {len(pet)})",
    ]
    out += [f"- {cortar(x, 220)}" for x in pet[-n:]]
    out += ["", f"## Últimas respuestas del asistente (últimas {min(5, len(resp))})"]
    out += [f"- {cortar(x, 400)}" for x in resp[-5:]]
    unicos = list(dict.fromkeys(archivos))
    out += ["", f"## Archivos tocados ({len(unicos)})"] + [f"- {x}" for x in unicos[-30:]]
    out += ["", f"## Comandos recientes (de {len(cmds)})"] + [f"- `{x}`" for x in cmds[-10:]]
    doc = "\n".join(out) + "\n"
    if a.resumir:
        p = (
            "Resumí esta conversación en español, en Markdown, con EXACTAMENTE estas secciones y solo con lo que se ve abajo: "
            "## Decisiones tomadas, ## Estado actual, ## Pendientes, ## Preferencias del usuario. Sé breve y no inventes.\n\n" + doc
        )
        r = subprocess.run(["claude", "-p", "--model", "haiku", p], capture_output=True, text=True, timeout=300, encoding="utf-8", errors="replace")
        if r.returncode:
            sys.exit("falló claude -p: " + r.stderr[:300])
        doc += "\n" + r.stdout.strip() + "\n"
    destino = HOME / "contexto" / "conversaciones" / f"{nombre}.md"
    destino.parent.mkdir(parents=True, exist_ok=True)
    tmp = destino.with_suffix(".tmp")
    tmp.write_text(doc, encoding="utf-8")
    tmp.replace(destino)
    despues = aprox(doc)
    base = ctx or antes
    print(
        f"escrito {destino}\n  contexto vivo de la sesión = {ctx} tokens | registro en disco ≈ {antes}"
        f" | documento ≈ {despues} tokens → {100 * despues / max(base, 1):.1f}% del contexto vivo"
    )


def aviso():
    try:
        d = json.load(sys.stdin)
    except ValueError:
        return
    tp = d.get("transcript_path")
    sid = d.get("session_id") or ""
    if not tp or not os.path.exists(tp):
        return
    ctx = 0
    with open(tp, encoding="utf-8", errors="ignore") as fh:
        for l in fh:
            if '"usage"' in l or '"PLANNER_RESPONSE"' in l:
                try:
                    row = json.loads(l)
                except ValueError:
                    continue
                u = (row.get("message") or {}).get("usage") or {}
                if u:
                    ctx = u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0) + u.get("cache_creation_input_tokens", 0)
                elif row.get("type") == "PLANNER_RESPONSE":
                    v = (row.get("input_tokens") or 0) + (row.get("cache_read_tokens") or 0)
                    if v:
                        ctx = v
    marca = HOME / "estado" / f"aviso-{sid}"
    if ctx < UMBRAL or marca.exists():
        return
    marca.parent.mkdir(parents=True, exist_ok=True)
    marca.write_text(str(ctx), encoding="utf-8")
    msg = f"Sesión {os.environ.get('AGENTE') or sid[:8]}: contexto ≈ {ctx} tokens (umbral {UMBRAL}). Conviene: compactar {sid}"
    with open(HOME / "estado" / "avisos.log", "a", encoding="utf-8") as fh:
        fh.write(time.strftime("%Y-%m-%d %H:%M ") + msg + "\n")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "aviso":
        return aviso()
    if len(sys.argv) > 2 and sys.argv[1] == "nueva":
        doc = Path(sys.argv[2]).read_text(encoding="utf-8", errors="replace")
        os.execvp(
            "claude",
            [
                "claude",
                "Retomás un trabajo previo. Este es el resumen de la conversación anterior; "
                "usalo como contexto y pedime la tarea siguiente:\n\n" + doc,
            ],
        )
    ap = argparse.ArgumentParser(prog="compactar")
    ap.add_argument("ref")
    ap.add_argument("--resumir", action="store_true")
    ap.add_argument("--max", type=int, default=15)
    generar(ap.parse_args())


if __name__ == "__main__":
    main()
