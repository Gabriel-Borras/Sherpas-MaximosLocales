#!/usr/bin/env python3
"""tokens — cuánto consumen tus sesiones (Claude Code + Antigravity, solo lectura).

  tokens                          resumen de los últimos 7 días, por agente
  tokens --desde 2026-11-01 --por proyecto|agente|modelo|dia|sesion
  tokens --sesion <id|nombre>     tamaño de contexto turno a turno
  tokens --json

Columnas: entrada (nueva), caché-lect (leída de caché), caché-esc (escrita a caché), salida, turnos.
"Contexto" = tamaño aproximado de la última petición (entrada + caché).
"""
import argparse
import collections
import datetime as dt
import glob
import json
import os
from pathlib import Path
import sys

for _s in (sys.stdout, sys.stderr):
    if hasattr(_s, "reconfigure"):
        _s.reconfigure(encoding="utf-8", errors="replace")

BASE_CLAUDE = Path(os.environ.get("CLAUDE_HOME") or (Path.home() / ".claude")) / "projects"
BASE_AGY = Path(os.environ.get("ANTIGRAVITY_BRAIN") or (Path.home() / ".gemini" / "antigravity" / "brain"))
CAMPOS = ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens")


def sesiones():
    for f in glob.glob(str(BASE_CLAUDE / "*" / "*.jsonl")):
        yield Path(f), "claude"
    for f in glob.glob(str(BASE_AGY / "*" / ".system_generated" / "logs" / "transcript.jsonl")):
        yield Path(f), "agy"


def leer_claude(f: Path):
    nombre = None
    msgs = {}
    try:
        with open(f, encoding="utf-8", errors="ignore") as fh:
            for l in fh:
                if '"custom-title"' in l:
                    try:
                        nombre = json.loads(l).get("customTitle") or nombre
                    except ValueError:
                        pass
                    continue
                if '"usage"' not in l:
                    continue
                try:
                    d = json.loads(l)
                except ValueError:
                    continue
                m = d.get("message") or {}
                u = m.get("usage")
                if d.get("type") != "assistant" or not u:
                    continue
                k = m.get("id") or d.get("uuid")
                msgs[k] = (d.get("timestamp", ""), m.get("model", "?"), u)
    except OSError:
        pass
    return nombre, sorted(msgs.values(), key=lambda x: x[0])


def leer_agy(f: Path):
    cid = f.parent.parent.parent.name
    nombre = f"agy:{cid[:8]}"
    msgs = []
    try:
        with open(f, encoding="utf-8", errors="ignore") as fh:
            for idx, l in enumerate(fh):
                if '"PLANNER_RESPONSE"' not in l:
                    continue
                try:
                    d = json.loads(l)
                except ValueError:
                    continue
                if d.get("type") != "PLANNER_RESPONSE":
                    continue
                u = {
                    "input_tokens": d.get("input_tokens") or 0,
                    "cache_read_input_tokens": d.get("cache_read_tokens") or 0,
                    "cache_creation_input_tokens": 0,
                    "output_tokens": d.get("output_tokens") or 0,
                }
                if not any(u.values()):
                    continue
                msgs.append((d.get("created_at", ""), d.get("model", "antigravity"), u))
    except OSError:
        pass
    return nombre, cid, msgs


def leer(f: Path, kind: str):
    if kind == "claude":
        nombre, ms = leer_claude(f)
        proyecto = f.parent.name
        sid = f.stem
        return nombre, sid, proyecto, ms
    nombre, cid, ms = leer_agy(f)
    return nombre, cid, "antigravity", ms


def main():
    ap = argparse.ArgumentParser(prog="tokens")
    ap.add_argument("--desde", default=(dt.date.today() - dt.timedelta(days=7)).isoformat())
    ap.add_argument("--por", default="agente", choices=["agente", "proyecto", "modelo", "dia", "sesion"])
    ap.add_argument("--sesion")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()

    if a.sesion:
        for f, kind in sesiones():
            nombre, sid, _, ms = leer(f, kind)
            if a.sesion in (sid, nombre, sid[:8]) and ms:
                print(f"# {nombre or '(sin nombre)'}  {sid}")
                for i, (ts, mod, u) in enumerate(ms, 1):
                    ctx = u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0) + u.get("cache_creation_input_tokens", 0)
                    print(f"{i:>4} {ts[11:19]} contexto={ctx:>8} salida={u.get('output_tokens', 0):>6} {mod}")
                return
        sys.exit("sesión no encontrada")

    acc = collections.defaultdict(lambda: dict.fromkeys(CAMPOS, 0) | {"turnos": 0, "ctx": 0})
    for f, kind in sesiones():
        nombre, sid, proyecto, ms = leer(f, kind)
        for ts, mod, u in ms:
            if ts and ts[:10] < a.desde:
                continue
            clave = {
                "agente": nombre or "(sin nombre)",
                "proyecto": proyecto,
                "modelo": mod,
                "dia": ts[:10] if ts else "?",
                "sesion": f"{nombre or '-'} {sid[:8]}",
            }[a.por]
            r = acc[clave]
            for c in CAMPOS:
                r[c] += u.get(c, 0) or 0
            r["turnos"] += 1
            r["ctx"] = u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0) + u.get("cache_creation_input_tokens", 0)
    if a.json:
        print(json.dumps(acc, indent=2, ensure_ascii=False))
        return
    print(f"{'':<34}{'entrada':>10}{'caché-lect':>12}{'caché-esc':>11}{'salida':>9}{'turnos':>8}{'contexto*':>11}")
    for k, r in sorted(
        acc.items(),
        key=lambda x: -(x[1]["input_tokens"] + x[1]["cache_read_input_tokens"] + x[1]["cache_creation_input_tokens"] + x[1]["output_tokens"]),
    ):
        print(
            f"{k[:33]:<34}{r['input_tokens']:>10}{r['cache_read_input_tokens']:>12}{r['cache_creation_input_tokens']:>11}"
            f"{r['output_tokens']:>9}{r['turnos']:>8}{r['ctx']:>11}"
        )
    print("* contexto = tamaño de la última petición de ese grupo")


if __name__ == "__main__":
    main()
